APP_ENV=dev
APP_SECRET=provider-secret-change-me

# PACT Broker
PACT_BROKER_BASE_URL=http://pact-broker:9292
PACT_BROKER_USERNAME=pact
PACT_BROKER_PASSWORD=pact

# Provider verification
PROVIDER_BASE_URL=http://provider:80
# APP_VERSION / CI_COMMIT_REF_NAME are injected by the Makefile (git SHA/branch)
# or by GitLab CI — not set here so they can't mask the real values.

DEFAULT_URI=http://localhost

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
